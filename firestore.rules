rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner() { return signedIn() && request.auth.token.email == 'omar.alabadi95@gmail.com'; }
    function isAdmin() { return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))); }

    match /cabinets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasOnly(['cab', 'who', 'note', 'time', 'done'])
        && request.resource.data.cab is int
        && request.resource.data.who is string && request.resource.data.who.size() > 0 && request.resource.data.who.size() <= 80
        && request.resource.data.note is string && request.resource.data.note.size() > 0 && request.resource.data.note.size() <= 1000
        && request.resource.data.done == false
        && request.resource.data.time == request.time;
      allow read, update, delete: if isAdmin();
    }
    match /log/{id} {
      allow read, create: if isAdmin();
    }
    match /admins/{email} {
      allow get: if signedIn() && request.auth.token.email == email;
      allow read: if isAdmin();
      allow write: if isOwner();
    }
  }
}
